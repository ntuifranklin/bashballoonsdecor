<!DOCTYPE html>
<html lang="zxx">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %> | <%= siteName %></title>
  <link rel="icon" href="assets/img/favicon.png">
  <!-- CSS only -->
   <link rel="stylesheet" type="text/css" href="assets/css/bootstrap.min.css">
   <link rel="stylesheet" href="assets/css/owl.carousel.min.css">
   <link rel="stylesheet" href="assets/css/owl.theme.default.min.css">
   <!-- fancybox -->
   <link rel="stylesheet" href="assets/css/jquery.fancybox.min.css">
   <!-- Font Awesome 6 -->
   <link rel="stylesheet" href="assets/css/fontawesome.min.css">
   <!-- style -->
   <link rel="stylesheet" href="assets/css/style.css">
   <!-- responsive -->
   <link rel="stylesheet" href="assets/css/responsive.css">
   <!-- color -->
   <link rel="stylesheet" href="assets/css/color.css">
   <% if ( typeof csrfToken !== 'undefined'  ) { %>
   	<meta name="csrf-token" content="<%= csrfToken %>">
   <% } %>
 </head>
<body>
<span class="loader"></span>
<header>
	<div class="container">
	  <div class="top-bar">
		
	  </div>
	  <div class="center-ber">
		<div class="logo">
		  <a href="/">
			<img alt="logo" src="assets/img/logo.png">
		  </a>
		</div>
		
		<ul class="social-media ">
			<li><a href="<%= facebookLink %>"><i class="fa-brands fa-facebook-f"></i></a></li>
			<li><a href="<%= instagramLink %>"><i class="fa-brands fa-instagram"></i></a></li>
			<li><a href="<%= twitterLink %>"><i class="fa-brands fa-twitter"></i></a></li>
			<li><a href="<%= youtubeLink %>"><i class="fa-brands fa-youtube"></i></a></li>
			<li><a href="<%= mediumLink %>"><i class="fa-brands fa-medium"></i></a></li>
	   
		  </ul>
		<form>
		  <input type="text" name="Search" placeholder="Search Our Bloon Selection">
		  <button><i class="fa-solid fa-magnifying-glass"></i></button>
		</form>
		
		<div class="login-bar d-flex">
		 
		  <div class="donation">
				  
				  <a href="JavaScript:void(0)" class="pr-cart">
					Cart
					<svg enable-background="new 0 0 512 512" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><g><path d="m452 120h-60.946c-7.945-67.478-65.477-120-135.054-120s-127.109 52.522-135.054 120h-60.946c-11.046 0-20 8.954-20 20v352c0 11.046 8.954 20 20 20h392c11.046 0 20-8.954 20-20v-352c0-11.046-8.954-20-20-20zm-196-80c47.484 0 87.019 34.655 94.659 80h-189.318c7.64-45.345 47.175-80 94.659-80zm176 432h-352v-312h40v60c0 11.046 8.954 20 20 20s20-8.954 20-20v-60h192v60c0 11.046 8.954 20 20 20s20-8.954 20-20v-60h40z"></path></g></svg>
				  </a>
				 
				  <div class="cart-popup">
  
					<% //console.log(`user cart is ${userCart}`); %>
					<% var grandTotal = 0 ; %>
					<% var totalItems = 0 ; %>
					<% if (Object.keys(userCart).length > 0 ) { %>
						<ul>
							<%  if ( "IndividualItems" in userCart)  { %>

								<% for (var itemKey in userCart["IndividualItems"] ) { %>
									<% //console.log(`userCart["IndividualItems"] : ${JSON.stringify(userCart["IndividualItems"], null, 4)}`); %>
                                    <% var individualItem = JSON.parse(JSON.stringify(userCart["IndividualItems"][itemKey])) ;%>
                                    <% var itemDetails = JSON.parse(JSON.stringify(individualItem["individualItemDetails"])) ; %>
									<li class="d-flex align-items-center position-relative">
		
										<div class="p-img light-bg">
				
										<img alt="img" src="https://via.placeholder.com/75x75">
				
										</div>
				
										<div class="p-data">
				
										<h3 class="font-semi-bold"><%= itemDetails["individItemTitle"] %></h3>
				
										<p class="theme-clr font-semi-bold"><%= individualItem["quantity"] %> x $<%= itemDetails["individItemUnitCost"] %></p>
										<% grandTotal = grandTotal + (individualItem["quantity"] * itemDetails["individItemUnitCost"]) ; %>
										</div>
				
										<a href="JavaScript:void(0)" id="crosss"></a>
				
									</li>
								<% } %>
							<% } %>
							
							<% if ("package" in userCart ) { %>
								<% //console.log(`userCart["package"] : ${JSON.stringify(userCart["package"], null, 4)}`); %>
								<% for (var packageKey in userCart["package"] ) { %>
									<% //console.log(`userCart["package"] : ${JSON.stringify(userCart["package"])}`); %>
                                    <% var package = JSON.parse(JSON.stringify(userCart["package"][packageKey])); %>
                                    <% var packageDetails = JSON.parse(JSON.stringify(package["packageDetails"])) ; %>
									<li class="d-flex align-items-center position-relative">
		
										<div class="p-img light-bg">
				
										<img alt="img" src="https://via.placeholder.com/75x75">
				
										</div>
				
										<div class="p-data">
				
										<h3 class="font-semi-bold"><%= packageDetails["packagedesc"] %></h3>
										<% grandTotal = grandTotal + (JSON.parse(JSON.stringify(package["quantity"])) * JSON.parse(JSON.stringify(packageDetails["packagecost"]))) ; %>

										<p class="theme-clr font-semi-bold"><%= JSON.parse(JSON.stringify(package["quantity"])) %> x $<%=  JSON.parse(JSON.stringify(packageDetails["packagecost"])) %></p>
				
										</div>
				
										<a href="JavaScript:void(0)" id="crosss"></a>
				
									</li>
								<% } %>
									
									
							<% } %>
						
						</ul>
  
						<div class="cart-total d-flex align-items-center justify-content-between">

						<span class="font-semi-bold">Total:</span>

						<span class="font-semi-bold">$<%= grandTotal %></span>

						</div>

						<div class="cart-btns d-flex align-items-center justify-content-between">

						<a class="font-bold" href="/cart">View Cart</a>

						<a class="font-bold theme-bg-clr text-white checkout" href="/checkout">Checkout</a>

						</div>

					<% } else { %>
						<ul>
							<li>
								<div class="alert alert-dark" role="alert">
									<hr>
									<h4 class="alert-heading">Sorry. Your Cart is Empty!</h4>
									<hr>
									<p class="mb-0">Please add some items to your cart.</p>
									<hr>
								</div>
							</li>
						</ul>
							
					<% } %>
				  </div>
  
		  </div>
		</div>
		<div class="bar-menu">
			<i class="fa-solid fa-bars"></i>
		</div>
	  </div>
	</div>
	<div class="nav-bar">
	  <div class="container">
		<nav class="navbar">
		  <ul class="navbar-links">
					  <li class="navbar-dropdown menu-item-children">
						<a href="/">
							<i>
						  		<img alt="home" src="assets/img/home.png">
							</i>Home
						</a>
						
					  </li>
					  <li class="navbar-dropdown menu-item-children">
						<a href="javascript:void(0)">Party Rental Individual Items</a>
						<div class="dropdown">
						  <a href="/products-list"> Individual Party Rental Items</a>
						  <% /* <a href="/products/productid">Product details</a> */ %>
						  <a href="/cart">Your Shopping Cart</a>
						  <a href="/checkout">Cart Checkout</a>
						</div>
					  </li>
					  
					  <li class="navbar-dropdown">
						<a href="/packages">Party Rental Packages</a>
					  </li>					  
					  <li class="navbar-dropdown">
						<a href="/contact">Contact</a>
					  </li>
		  </ul>
		  
			<a class="phone" href="callto:<%= customerServiceNumber %>">
				<i>
					<svg height="112" viewBox="0 0 24 24" width="112" xmlns="http://www.w3.org/2000/svg">
						<g clip-rule="evenodd" fill="rgb(255255,255)" fill-rule="evenodd">
							<path d="m7 2.75c-.41421 0-.75.33579-.75.75v17c0 .4142.33579.75.75.75h10c.4142 0 .75-.3358.75-.75v-17c0-.41421-.3358-.75-.75-.75zm-2.25.75c0-1.24264 1.00736-2.25 2.25-2.25h10c1.2426 0 2.25 1.00736 2.25 2.25v17c0 1.2426-1.0074 2.25-2.25 2.25h-10c-1.24264 0-2.25-1.0074-2.25-2.25z"></path><path d="m10.25 5c0-.41421.3358-.75.75-.75h2c.4142 0 .75.33579.75.75s-.3358.75-.75.75h-2c-.4142 0-.75-.33579-.75-.75z"></path><path d="m9.25 19c0-.4142.33579-.75.75-.75h4c.4142 0 .75.3358.75.75s-.3358.75-.75.75h-4c-.41421 0-.75-.3358-.75-.75z">

							</path>
						</g>
					</svg>
			  	</i>
				<%= customerServiceNumber %> 
			</a>
			<br/>
			
			<a class="phone" href="callto:<%= customerServiceNumberExtra %>">
				<i>
					<svg height="112" viewBox="0 0 24 24" width="112" xmlns="http://www.w3.org/2000/svg">
						<g clip-rule="evenodd" fill="rgb(255255,255)" fill-rule="evenodd">
							<path d="m7 2.75c-.41421 0-.75.33579-.75.75v17c0 .4142.33579.75.75.75h10c.4142 0 .75-.3358.75-.75v-17c0-.41421-.3358-.75-.75-.75zm-2.25.75c0-1.24264 1.00736-2.25 2.25-2.25h10c1.2426 0 2.25 1.00736 2.25 2.25v17c0 1.2426-1.0074 2.25-2.25 2.25h-10c-1.24264 0-2.25-1.0074-2.25-2.25z"></path>
							<path d="m10.25 5c0-.41421.3358-.75.75-.75h2c.4142 0 .75.33579.75.75s-.3358.75-.75.75h-2c-.4142 0-.75-.33579-.75-.75z"></path>
							<path d="m9.25 19c0-.4142.33579-.75.75-.75h4c.4142 0 .75.3358.75.75s-.3358.75-.75.75h-4c-.41421 0-.75-.3358-.75-.75z"></path>
						</g>
				</svg>
				</i>
				<%= customerServiceNumberExtra %> 
			</a>
			
		</nav>
	  </div>
	</div>
	<div class="mobile-nav hmburger-menu" id="mobile-nav" style="display:block;">
		<div class="res-log">
		  <a href="/">
			<img src="assets/img/logo-b.png" alt="Responsive Logo">
		  </a>
		</div>
		  <ul>

			<li class="menu-item-has-children"><a href="/">Home</a>
			
			</li>
			<li class="menu-item-has-children"><a href="JavaScript:void(0)">Party Rental Individual Items</a>
			  <ul class="sub-menu">
				<li><a href="/products-list">Party Rental Individual Items List</a></li>
				<% /*<li> <a href="/product-details">product details</a></li>*/ %>
				<li><a href="/cart">Shopping Cart</a></li>
				<li><a href="/checkout">Cart Checkout</a></li>
			  </ul>
			</li>
  
			<li><a href="/contact">Contacts</a></li>
  
			</ul>
  
			
	</div>
</header>

