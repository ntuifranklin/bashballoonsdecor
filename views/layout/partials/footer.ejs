			<% 
			  function capitalizeFirstLetter(wordin) { 
				const word = wordin ;

				words = word.split(" ");

				for (var i=0 ; i < words.length; i++) {
					var w = words[i] ;
					const firstLetter = w.charAt(0) ;
					const firstLetterCap = firstLetter.toUpperCase() ;
					const remainingLetters = w.slice(1) ;
					const capitalizedWord = firstLetterCap + remainingLetters ;
					words[i] = capitalizedWord ;
				}

				
				const w2 = words.join(" ");
				return w2 ;
			  }
			
			%>
	
			<% var l1 = Math.ceil(categories.length/3);%>
			
			<% for (var l=0 ; l < l1; l++ ) { %>
								
				<% var category_l = JSON.parse(JSON.stringify(categories[l])) ; %>
				<% var category_name_l = category_l.category_name.toLowerCase();  %>
				<li class="dropdown">
					<i class="fa-solid fa-angle-right"></i>
					<a href="/<%= category_name_l %>"><%= capitalizeFirstLetter(category_name_l) %></a>
			  	</li>
			<% } %>
			</ul>
		  </div>
		</div>
		
		
