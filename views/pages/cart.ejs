
<section class="banner" style="background-image:url(https://via.placeholder.com/1920x300)">
    <div class="container">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="index.html">Home</a>
        </li>
        <li class="breadcrumb-item">
          <a href="#">Balloons</a>
        </li>
          <li class="breadcrumb-item active" aria-current="page">Cart</li>
      </ol>
      <h2>My Cart</h2>
    </div>
  </section>
  <section class="gap">
      <div class="container">
        
        <% var noKeys = Object.keys(userCart) ; %>
                
        <% if(noKeys.length == 0) { %>
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Your Cart is Empty!</h4>
                <p>Looks like you haven't added any items to your cart yet.</p>
                <hr>
                <p class="mb-0">Please add some items to your cart.</p>
            </div>
        <% } else { %>
          <div class="row">
            <form class="woocommerce-cart-form">
              <div class="row">
                <div class="col-lg-8">
                  <div style="overflow-x:auto;overflow-y: hidden;">
                        <table class="shop_table table-responsive">
                            <thead>
                                <tr>
                                    <th class="product-name">Product Detail</th>
                                    <th class="product-price">Each Price</th>
                                    <th class="product-quantity">Quantity</th>
                                    <th class="product-subtotal">Total Price</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                            <%  if ("product" in userCart ) { %>
                                <% for( productKey in userCart["product"])  { %>
                            
                                    <tr class="product">
                                        <td class="product-name">
                                            <img alt="img" src="https://via.placeholder.com/70x70">
                                            <div>
                                                <span><%= productKey %></span>
                                                <p>Title description</p>
                                                
                                                <p>SKU: <%= productKey %></p>
                                            </div>
                                        </td>
                                        <td class="product-price">
                                            <span class="woocommerce-Price-amount"><bdi><span class="woocommerce-Price-currencySymbol">$</span>18.61</bdi>
                                            </span>          
                                        </td>
                                        <td class="product-quantity">
                                            Quantity<input type="number" class="input-text" value="1" min="1" >
                                        </td>
                                        <td class="product-subtotal">
                                            <span class="woocommerce-Price-amount"><bdi><span class="woocommerce-Price-currencySymbol">$</span>Price : 18.61</bdi></span>
                                        </td>
                                        <td class="product-remove">
                                            <a href="#"><i class="fa-regular fa-circle-xmark"></i></a>
                                        </td>
                                    </tr>
                                <% } %>
                            <% } else if ("package" in userCart) { %>
                                <% for ( packageKey in userCart["package"])  { %>
                                        <tr class="product">
                                            <td class="product-name">
                                                <img alt="img" src="https://via.placeholder.com/70x70">
                                                <div>
                                                    <span><%= packageKey %></span>
                                                    <p>Title description</p>
                                                    
                                                    <p>SKU: <%= packageKey %></p>
                                                </div>
                                            </td>
                                            <td class="product-price">
                                                <span class="woocommerce-Price-amount"><bdi><span class="woocommerce-Price-currencySymbol">$</span>18.61</bdi>
                                                </span>          
                                            </td>
                                            <td class="product-quantity">
                                                Quantity<input type="number" class="input-text" value="1" min="1" >
                                            </td>
                                            <td class="product-subtotal">
                                                <span class="woocommerce-Price-amount"><bdi><span class="woocommerce-Price-currencySymbol">$</span>Package Sub Total Price : 18.61</bdi></span>
                                            </td>
                                            <td class="product-remove">
                                                <a href="#"><i class="fa-regular fa-circle-xmark"></i></a>
                                            </td>
                                        </tr>
                                <% } %>
                        <% } %>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4">
                                        <div class="d-flex align-items-center justify-content-between">
                                            <h4>03 items</h4>
                                            <h5>$46.61</h5>
                                        </div>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                  </div>
                </div>
                <div class="col-lg-4">
                  <div class="coupon-area">
                              <h3>Apply Coupon</h3>
                              <div class="coupon">
                                  <input type="text" name="coupon_code" class="input-text" placeholder="Coupon code">
                                  <button type="submit" class="btn" name="apply_coupon"><span>Apply coupon</span>
                                  </button>
                              </div>
                          </div>
                          <div class="cart_totals">
                              <h4>Payment Total</h4>
                              <table class="shop_table_responsive">
                                  <tbody>
                                      <tr class="cart-subtotal">
                                          <th>Subtotal:</th>
                                          <td>
                                              <span class="woocommerce-Price-amount">
                                              <bdi>
                                                  <span class="woocommerce-Price-currencySymbol">$</span>250.00
                                              </bdi>
                                              </span>
                                          </td>
                                      </tr>
                                      <tr class="Shipping">
                                          <th>Shipping:</th>
                                          <td>
                                              <span class="woocommerce-Price-amount amount">
                                                  free
                                              </span>
                                           </td>
                                      </tr>
                                      <tr class="Total">
                                          <th>Total:</th>
                                          <td>
                                              <span class="woocommerce-Price-amount">
                                              <bdi>
                                                  <span>$</span>250.00
                                              </bdi>
                                              </span>
                                          </td>
                                      </tr>
                                  </tbody>
                              </table>
                              <div class="wc-proceed-to-checkout">
                                <a href="/checkout" class="btn">
                                  <span>
                                      Proceed to checkout
                                  </span>
                                  </a>
                              </div>
                          </div>
                </div>
              </div>
            </form>
          </div>
        <% } %>
      </div>
  </section>