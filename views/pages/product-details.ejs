<%

/* The function belows generates random number of reviews */
function getRandomReviews() {
  return Math.ceil(Math.random() * (300 - 100) + 100);
}


function getRandomPercentageOff() {
  //between 12% and 18% off 
  return Math.ceil(Math.random() * (18 - 12) + 12);
}

