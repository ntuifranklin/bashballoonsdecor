      <div class="row">
        <div id="productDetailsUpdateIndex" class="col-md-12">
        </div>
      </div>
      <div class="row">
        <div class="col-lg-6">
          <div class="pd-gallery">
            <ul class="pd-imgs">
                  <li class="li-pd-imgs nav-active">
                      <a href="JavaScript:void(0)">
                        <img alt="ballon" src="https://via.placeholder.com/384x320">
                      </a>
  
                  </li>
                  <li class="li-pd-imgs">
                    <a href="JavaScript:void(0)">
                      <img alt="ballon" src="https://via.placeholder.com/384x320">
                    </a>
                  </li>
                  <li class="li-pd-imgs">
                    <a href="JavaScript:void(0)">
                      <img alt="ballon" src="https://via.placeholder.com/384x320">
                    </a>
  
                  </li>
