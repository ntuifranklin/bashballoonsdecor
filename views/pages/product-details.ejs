              <p>Save <%= percentOff %>%</p>
              <h5>SKU-<%= item.category_webid %></h5>
            </div>
            <h2><%= item.item_name %></h2>
            
            <div class="star">
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <i class="fa-solid fa-star"></i>
              <span>( <%= getRandomReviews() %> Reviews )</span> 
            </div>
  
            <div class="price">
              <div>
                <div class="d-flex"><h3>$<%= item.unitPrice %></h3><del>$<%= Math.ceil(parseFloat(item.unitPrice) * (1 + (percentOff/100.0))) %></del></div>
                <span class="dots">In stock, <%= parseInt(item.quantityAvailable) %> units</span>
                <div class="quantity">
                  <!-- 
                  <h6>colors:</h6>
                  <ul class="color">
                    <li class="purple"></li>
                    <li class="blue"></li>
                    <li class="orange"></li>
                  </ul>
                  -->
                </div>
                <% 
                  var cartItemQuantity = 1 ;
                  // userCart[itemID]["quantity"] = integerQuantity ;
                  var itemID = new String(item.item_id);
                  if ( ( itemID in userCart) && ("quantity" in userCart[itemID]) )
                    cartItemQuantity = userCart[itemID]["quantity"] ;
                
                %>
                <% var htmlIDX = new String(item.item_id);  %>
                <div class="quantity">
                  <h6>Quantity:</h6>
                   <!-- the value productDetailsUpdateIndex is the Id of the DIV where to place the confirmation that the cart was updated -->
                  <input type="number" class="input-text" id="<%= htmlIDX %>" onchange="changeItemQuantity('<%= item.item_id %>',source='#', htmlID='<%= htmlIDX %>', alertIndex='productDetailsUpdateIndex')" value="<%= cartItemQuantity %>" min="1" >
                  
                </div>
                <div class="add-to-cart">
        
                  <% var htmlID = new String(item.item_id);  %>
                  <a id="<%= htmlID %>" class="btn" onclick='updateCart("<%= item.item_id %>", source="#", htmlID="<%= htmlID %>", alertIndex="productDetailsUpdateIndex")'>
                    <span>Add to Cart</span>
                  </a>
                  <a href="#" class="heart-wishlist">
                    <i class="fa-regular fa-heart"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="payment-methods">
            <h5>PAYMENT METHODS:</h5>
            <a href="/assets/img/card.png">
              <img alt="card" src="/assets/img/card.png">
            </a>
            <p>Your payment information is processed securely. We do not store credit card details nor have access to your credit card information.</p>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="payment-methods">
            <ul class="product_meta">
                  <li>
                    <span class="theme-bg-clr"><%= item_category_name %>:</span>
                    <ul class="pd-cat">
                      <li>
                        <a href="/<%= item_category_name %>">Similar products in this cateogry</a>
                        <!-- 
                        <a href="#">balloon</a>,
                        <a href="#">new products</a>
                        -->
                      </li>          
                    </ul>
                  </li>
            </ul>
            <ul class="social-media ">
              <li><a href="<%= facebookLink %>"><i class="fa-brands fa-facebook-f"></i></a></li>
              <li><a href="<%= instagramLink %>"><i class="fa-brands fa-instagram"></i></a></li>
              <li><a href="<%= twitterLink %>"><i class="fa-brands fa-twitter"></i></a></li>
              <li><a href="<%= youtubeLink %>"><i class="fa-brands fa-youtube"></i></a></li>
              <li><a href="<%= mediumLink %>"><i class="fa-brands fa-medium"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
