      <div class="product-slider two owl-carousel owl-theme">
        

        <% for ( var i = 0 ; i < itemsWithSimilarCategoryID.length ; i++ ) { %>
          <% var similar_item = itemsWithSimilarCategoryID[i] %>
        <div class="item">
          <div class="product-style">
            <img alt="img" src="https://via.placeholder.com/195x210">
            <a href="/product-details/<%= similar_item.category_webid %>">
              <h5><%= similar_item.item_name %></h5>
            </a>
              <h6>$<%= similar_item.unitPrice %></h6>
              <span>In stock, <%= similar_item.quantityAvailable %> units</span>
              <div class="add-to-cart">

                <% var htmlID2 = new String(item.item_id) + "2";  %>
