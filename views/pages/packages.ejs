
<section class="banner" style="background-image:url(https://via.placeholder.com/1920x300)">
    <div class="container">
      <ol class="breadcrumb">
        <li class="breadcrumb-item">
          <a href="/">Home</a>
        </li>
        <li class="breadcrumb-item">
          <a href="#">Seasonal & Holidays</a>
        </li>
          <li class="breadcrumb-item active" aria-current="page">Packages</li>
      </ol>
      <h2>Packages</h2>
    </div>
  </section>
  <section class="gap">
    <div class="container">
      <div class="row">
        <% var allpackages = [package3000, package3800, package4900] ; %>
         
        <% for (var j = 0; j < allpackages.length; j++) { %>

          <% var package = JSON.parse(JSON.stringify(allpackages[j])); %>
          <% console.log(`package : ${JSON.stringify(package, null, 4)}`); %>
          <div class="col-md-3 col-lg-4">
            <div class="occians-holidays for mt-md-0">
              <figure>
                <img alt="holidays" src="https://via.placeholder.com/290x290">
              </figure>
              <div class="holidays-text">
                <h4><%= package[0].packagedesc %></h4>
                <ul>
                  <% for (var i = 0; i < package.length; i++) { %>
                      <li>  
                        <div class="bol"></div><%= package[i].qtyneeded %> &nbsp; <%= package[i].itemdesc %>
                         
                      </li>
                  <% } %>
                </ul>
                <h5>$<%= package[0].packagecost %></h5>
              </div>
                       
              <div class="add-to-cart two">
                                
                <a href="#" class="btn" onclick='updateCart("<%= package[0].packageid %>","package")'><span>Add to Cart</span></a>
                <a href="#" class="heart-wishlist">
                  <i class="fa-regular fa-heart"></i>
                </a>
              </div>
            </div>
          </div>
          <% } %>
    
      </div>
    </div>
  </section>
