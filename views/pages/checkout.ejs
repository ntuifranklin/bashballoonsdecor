
<%  //console.log(`user cart in checkout : ${JSON.stringify(userCart, null,4)}`); %>
<% 
	//loop through userCart to get the total cost
	var totalCost = 0.0;
	
	for (var itemKey in userCart)  { 
		var item = JSON.parse(JSON.stringify(userCart[itemKey]));
		var itemDetails = JSON.parse(JSON.stringify(item["itemDetails"])) ;
		var itemSubTotal = item["quantity"] * itemDetails["unitPrice"] ;
		totalCost += ( 
			itemSubTotal
		);
	}
	
%>
<section class="banner" style='background-image:url("<%= IMG_DIR_FOR_WEB %>1920x300.png")'>
	<div class="container">
	  <ol class="breadcrumb">
		<li class="breadcrumb-item">
		  <a href="/">Home</a>
		</li>
		<li class="breadcrumb-item">
		  <a href="#">Balloons</a>
		</li>
		  <li class="breadcrumb-item active" aria-current="page">cart</li>
	  </ol>
	  <h2>Checkout</h2>
	</div>
</section>

<section class="gap">
<div class="container">
	<% //console.log(`Cart in cart.ejs ${JSON.stringify(userCart, null, 4)}`); %>
	<% var noKeys = Object.keys(userCart) ; %>
	<% if ( noKeys.length == 0 ) { %>
		<div class="row">
			<div class="col-lg-12">
				
			<div class="alert alert-dark" role="alert">
				<h4 class="alert-heading">Your Cart is Empty!</h4>
				<p>Looks like you haven't added any items to your cart yet.</p>
				<hr>
				<p class="mb-0">Please add some items to your cart.</p>
				
				<ul>
					<li><a href="/" class="link-primary">Affordable Party Rental Items</a></li>
				</ul>
			</div>
			</div>
		</div>
	<% } else if ( error != undefined && error != null) { %>

		<div class="row">
			<div class="col-lg-12">
				
			<div class="alert alert-danger" role="alert">
				<h4 class="alert-heading">Some errors occured while processing your form </h4>
				<p><%= error %></p>
				<hr>
				
			</div>
			</div>
		</div>
	<% } else if ( success != undefined && success != null) { %>
		
		<div class="row">
			<div class="col-lg-12">
				
			<div class="alert alert-success" role="alert">
				<h4 class="alert-heading">Hoohooo! </h4>
				<p><%= success %></p>
				<hr>
				
			</div>
			</div>
		</div>

	<% } else { %>
	
	<form class="checkout-meta donate-page" id="ordercheckout" method="POST" action="/checkout">
		<!-- Begin listing cart items -->
		
		<div class="row">
			<div id="checkoutUpdateIndex" class="col-md-12 col-lg-12">
			</div>
		</div>
		<div class="row">
			<div class="col-lg-12">
			<div style="overflow-x:auto;overflow-y: hidden;">
					<table class="shop_table table-responsive" id="checkoutTableListItems">
						<thead>
							<tr>
								<th class="product-name">Rental Item Name</th>
								<th class="product-price">Unit Price</th>
								<th class="product-quantity">Quantity</th>
								<th class="product-subtotal">Total Price</th>
								<th></th>
							</tr>
						</thead>
						<tbody>
						<% 
						var grandTotal = 0 ;
						var totalItems = 0 ; 
						
						function trimItemName(name="",size=16) {
							const n = new String(name);
							if (n.length >= size )
							return n.slice(0,(size-4)) + " ..." ;
							
							return n ;
						
						} ;
						%>
						
						<% for(var itemKey in userCart)  { %>
							<% var item = JSON.parse(JSON.stringify(userCart[itemKey])) ;%>
							<% var itemDetails = JSON.parse(JSON.stringify(item["itemDetails"])) ; %>
							<tr class="product">
								<td class="product-name">

									
									<% if (itemDetails.imageurl != "" ) {%>
										<img loading="lazy" src="<%= IMG_DIR_FOR_WEB + itemDetails.imageurl %>" width=70 height=70 />
									<% } else { %>
										<img loading="lazy" src="<%= IMG_DIR_FOR_WEB %>70x70.png" width=70 height=70 />
										<!-- <img loading="lazy" src="https://via.placeholder.com/70x70" /> -->
										<!-- https://via.placeholder.com/70x70 -->
									<% } %>

									
									<div>
										<% const trimmedName = trimItemName(name=decode(itemDetails.item_name)); %>
										<span><%= trimmedName %></span>
										<p><%= trimmedName %></p>
										
										<p>SKU: <%= itemDetails.category_webid %></p>
									</div>
								</td>
								<td class="product-price">
									<span class="woocommerce-Price-amount">
										<bdi>
											<span class="woocommerce-Price-currencySymbol">$</span><%= itemDetails.unitPrice %>
										</bdi>
										</span>          
								</td>
								<%
								/*
									Add event that will update the quantity of an item in a cart
								
								*/
								var htmlID2 = item.category_webid + "1"; 
							   
								//'cartUpdateIndex' is the id of the div where the alert will be displayed
								%>
							
								<td class="product-quantity">
									Quantity<input type="number" id="<%= htmlID2 %>" onchange="changeItemQuantity('<%= itemDetails.item_id %>',source='#', htmlID='<%= htmlID2 %>', alertIndex='checkoutUpdateIndex')" class="input-text" value="<%= item.quantity %>" min="1" >
								</td>
								
								<% totalItems += item.quantity ; %>
								<% var itemsSubTotal = item.quantity * itemDetails.unitPrice %>
								<td class="product-subtotal">
									<span class="woocommerce-Price-amount">
										<bdi>
											<span class="woocommerce-Price-currencySymbol">$</span><%= itemsSubTotal %>
										</bdi>
									</span>
								</td>
								<% grandTotal += itemsSubTotal ; %>
								<td class="product-remove">
									<a>
										<i class="fa-regular fa-circle-xmark" onclick="deleteItem('<%= itemDetails.item_id %>',source='checkout', htmlID='<%= htmlID2 %>', alertIndex='checkoutUpdateIndex')">

										</i>
									</a>
								</td>
							</tr>
						<% } %>
					
						
						
						</tbody>
						<tfoot>
							<tr>
								<td colspan="4">
									<div class="d-flex align-items-center justify-content-between">
										<h4><%= totalItems %> items</h4>
										<h5>$<%= grandTotal.toFixed(2) %></h5>
									</div>
								</td>
							</tr>
						</tfoot>
					</table>
			</div>
			</div>
		
		</div>
		<!-- End listing cart items -->

		<div class="row">
			<div id="processOrderResult" class="col-md-12 col-lg-12">
			</div>
		</div>

		<!-- Billing Details -->
		<div class="row">
			<div class="col-lg-8">
				<h3 class="pb-3">Billing details</h3>
					<div class="col-lg-12">
						<input type="text" class="input-text " name="completename" placeholder="Complete Name">
						<input type="email" class="input-text " name="email" placeholder="Email address">
						<input type="text" name="street_address" placeholder="Street Address">
						<%
						/*
						<!--
							<select name="billing_country" class="nice-select Advice country_to_state">
							<option>Country</option>
							<option>Select Topic 1</option>
							<option>Select Topic 2</option>
							<option>Select Topic 3</option>
							<option>Select Topic 4</option>
							</select>
						-->
						*/
						%>
						<div class="row">
							<div class="col-lg-6">
								<input type="text" name="city" placeholder="City">
							</div>
							<div class="col-lg-6">
								<select name="state" class="nice-select Advice state province">
									<option>State</option>
									<option value="AL">Alabama</option>
									<option value="AK">Alaska</option>
									<option value="AZ">Arizona</option>
									<option value="AR">Arkansas</option>
									<option value="CA">California</option>
									<option value="CO">Colorado</option>
									<option value="CT">Connecticut</option>
									<option value="DE">Delaware</option>
									<option value="DC">District Of Columbia</option>
									<option value="FL">Florida</option>
									<option value="GA">Georgia</option>
									<option value="HI">Hawaii</option>
									<option value="ID">Idaho</option>
									<option value="IL">Illinois</option>
									<option value="IN">Indiana</option>
									<option value="IA">Iowa</option>
									<option value="KS">Kansas</option>
									<option value="KY">Kentucky</option>
									<option value="LA">Louisiana</option>
									<option value="ME">Maine</option>
									<option value="MD">Maryland</option>
									<option value="MA">Massachusetts</option>
									<option value="MI">Michigan</option>
									<option value="MN">Minnesota</option>
									<option value="MS">Mississippi</option>
									<option value="MO">Missouri</option>
									<option value="MT">Montana</option>
									<option value="NE">Nebraska</option>
									<option value="NV">Nevada</option>
									<option value="NH">New Hampshire</option>
									<option value="NJ">New Jersey</option>
									<option value="NM">New Mexico</option>
									<option value="NY">New York</option>
									<option value="NC">North Carolina</option>
									<option value="ND">North Dakota</option>
									<option value="OH">Ohio</option>
									<option value="OK">Oklahoma</option>
									<option value="OR">Oregon</option>
									<option value="PA">Pennsylvania</option>
									<option value="RI">Rhode Island</option>
									<option value="SC">South Carolina</option>
									<option value="SD">South Dakota</option>
									<option value="TN">Tennessee</option>
									<option value="TX">Texas</option>
									<option value="UT">Utah</option>
									<option value="VT">Vermont</option>
									<option value="VA">Virginia</option>
									<option value="WA">Washington</option>
									<option value="WV">West Virginia</option>
									<option value="WI">Wisconsin</option>
									<option value="WY">Wyoming</option>
								</select>
							</div>
							<div class="col-lg-6">
								<input type="text" name="zipcode" placeholder="Postal Code">
							</div>
							<div class="col-lg-6">
								<input type="tel" class="input-text " name="phone"  placeholder="Phone">
							</div>
						</div>
						<%
						/*
						<!-- 
						<div class="ship-address">
							
							<div class="d-flex">
							<input type="radio" id="Create" name="Create" value="Create">
							<label for="Create">
								Create an account for later use
							</label>
							</div>
							<div class="d-flex">
							<input type="radio" id="ShipAddress" name="Create" value="ShipAddress">
							<label for="ShipAddress">
									Deliver to same Address
							</label>
							</div>
							
						</div>
						-->
						*/
						%>
					</div>
					<div class="woocommerce-additional-fields">
						<textarea name="order_note" class="input-text " placeholder="Order Note"></textarea>
					</div>
			</div>
			<div class="col-lg-4">
				<div class="cart_totals-checkout">
					<div class="cart_totals cart-Total">
							<h4 class="pt-0">Cart Total</h4>
							<table class="shop_table_responsive">
								<tbody>
									<tr class="cart-subtotal">
										<th>Subtotal:</th>
										<td>
											<span class="woocommerce-Price-amount">
											<bdi>
												<span class="woocommerce-Price-currencySymbol">$</span><%= grandTotal.toFixed(2) %>
											</bdi>
											</span>
										</td>
									</tr>
									<tr class="Shipping">
										<th>Shipping:</th>
										<td>
											<span class="woocommerce-Price-amount amount">
												free
											</span>
										</td>
									</tr>
									<tr class="Total">
										<th>Total:</th>
										<td>
											<span class="woocommerce-Price-amount">
											<bdi>
												<span>$</span><%= grandTotal.toFixed(2) %>
											</bdi>
											</span>
										</td>
									</tr>
								</tbody>
							</table>
					</div>
					<div class="checkout-side">
						<h4>Payment Method</h4>
						<ul>
							<!--
							<li>
								<input type="radio" id="Bank_Payment" name="Bank_Payment" value="Bank_Payment">
								<label for="Bank_Payment">
										Bank Payment
								</label>
							</li>
							<li>
								<input type="radio" id="Check_Payment" name="Bank_Payment" value="Check_Payment">
								<label for="Check_Payment">
										Check Payment
								</label>
							</li>
							<li>
								<input type="radio" id="PayPal" name="Bank_Payment" value="Check_Payment">
								<label for="PayPal">
										PayPal
								</label>
							</li>
							-->
							<li>
								<input type="radio" id="Cash on Delivery" name="Bank_Payment" value="Check_Payment">
								<label for="Cash on Delivery">
										Cash on Delivery
								</label>
							</li>
						</ul>
						<button id="orderCheckoutSubmitButton" type="submit" class="btn"><span>Place Order</span></button>
						<input type="hidden" name="_csrf" value='<%= csrfToken %>'>
					</div>
				</div>
			</div>
		</div>
		
	</form>
	<% } %>
</div>
</section>